{
  "name": "teststudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc -p frontend/tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "start:desktop": "electron .",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "pinia": "4.1.0",
    "@lucide/vue": "1.64.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
